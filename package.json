{
  "name": "graphium",
  "productName": "Graphium",
  "description": "The digital stylus for world builders. Inscribe the world on an infinite canvas.",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "tsc && vite build && electron-builder",
    "build:web": "tsc && vite build --mode web",
    "build:electron": "tsc && vite build",
    "preview:web": "vite preview --outDir dist-web",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "lint:strict": "eslint . --ext ts,tsx --max-warnings 0",
    "lint:ci": "eslint . --ext ts,tsx --format json --output-file eslint-report.json --max-warnings 0 || true && eslint . --ext ts,tsx --max-warnings 0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "lint-staged": "lint-staged",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "playwright test accessibility.spec.ts --config=playwright.config.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:web": "playwright test --config=playwright.config.ts --project=Web-Chromium",
    "test:e2e:electron": "playwright test --config=playwright.config.ts --project=Electron-App",
    "test:e2e:functional": "playwright test tests/functional/ --config=playwright.config.ts",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config=playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@remixicon/react": "^4.8.0",
    "electron-log": "^5.2.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "konva": "^10.0.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.6",
    "react-konva": "^18.2.14",
    "use-image": "^1.1.4",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@ibm/plex": "^6.4.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.0.18",
    "agentation": "^2.2.0",
    "autoprefixer": "^10.4.22",
    "axe-core": "^4.11.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.2.2",
    "vite": "^6.4.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.18"
  },
  "main": "dist-electron/main.js",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,css}": [
      "prettier --write"
    ]
  }
}
