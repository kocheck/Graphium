// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.graphium.app",
  "asar": true,
  "asarUnpack": [
    "dist/screenshots/**/*"
  ],
  "productName": "Graphium",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "publish": {
    "provider": "github",
    "owner": "kocheck",
    "repo": "Graphium"
  },
  // .graphium campaigns: Finder (macOS), Explorer (NSIS), and desktop entry (Linux)
  "fileAssociations": [
    {
      "ext": "graphium",
      "name": "Graphium Campaign",
      "description": "Graphium Campaign",
      "role": "Editor",
      "rank": "Owner",
      "mimeType": "application/x-graphium"
    }
  ],
  // Developer ID distribution (not Mac App Store). Signing uses CSC_LINK / CSC_KEY_PASSWORD;
  // notarization runs only when APPLE_API_KEY, APPLE_API_KEY_ID and APPLE_API_ISSUER are set.
  // Separate arm64 and x64 builds: half the download of a universal app, and
  // electron-updater picks the matching zip from latest-mac.yml.
  "mac": {
    "category": "public.app-category.role-playing-games",
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] },
      // zip is what electron-updater installs on macOS; the dmg is for first install
      { "target": "zip", "arch": ["arm64", "x64"] }
    ],
    "artifactName": "${productName}-Mac-${version}-${arch}.${ext}",
    "hardenedRuntime": true,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "notarize": true,
    "extendInfo": {
      "UTExportedTypeDeclarations": [
        {
          "UTTypeIdentifier": "com.graphium.campaign",
          "UTTypeDescription": "Graphium Campaign",
          "UTTypeConformsTo": ["public.data", "public.content"],
          "UTTypeTagSpecification": {
            "public.filename-extension": ["graphium"],
            "public.mime-type": ["application/x-graphium"]
          }
        }
      ]
    }
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  }
}
